# Jev is available through OpenRouter (model typesafe/jev-1.13) -- one key
# for everything -- or directly from TypeSafe (console.typesafe.ai).  Set one.
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=
# JEV_MODEL=typesafe/jev-1.13

# Optional. Without it the review queue is open (fine on your own machine);
# with it, ruling on uncertain verdicts needs this bearer token.
# RADAR_REVIEW_TOKEN=

# Optional. Where the SQLite file lives (default data/radar.db).
# RADAR_DB=data/radar.db
