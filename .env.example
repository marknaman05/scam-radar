# Jev, via whichever gateway you have a key for (first one set wins):
# AI_GATEWAY_API_KEY=      Vercel AI Gateway (vercel.com -> AI Gateway -> API keys)
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=        TypeSafe directly (console.typesafe.ai)
# JEV_MODEL=               override the model id for the chosen gateway

# Optional. Without it the review queue is open (fine on your own machine);
# with it, ruling on uncertain verdicts needs this bearer token.
# RADAR_REVIEW_TOKEN=

# Optional. Where the SQLite file lives (default data/radar.db).
# RADAR_DB=data/radar.db

